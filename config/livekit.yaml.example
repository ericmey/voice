# livekit-server runtime config.
#
# Copy to config/livekit.yaml (gitignored) and edit:
#   - `keys`: generate a strong secret; the devkey/devsecret default below is
#     only useful for a first-boot smoke test on a disconnected box.
#   - `redis.address`: `redis:6379` — the compose service name. The
#     livekit-server container is on the compose bridge network, so it reaches
#     redis by service name on both Linux and Mac. (Do NOT use
#     host.docker.internal — that routes to the host, not the redis container.)
#
# Bind-mounted into the voice-livekit-server container at /etc/livekit.yaml.

port: 7880

rtc:
  tcp_port: 7881
  udp_port: 7882
  # FALSE when every WebRTC peer is on the same box (livekit-sip, the agent
  # workers, egress) — which is the mizuki shape. With `true`, the server does a
  # STUN lookup at boot, advertises the WAN address, and then fails to validate it
  # on any router that will not hairpin — logging `could not validate external IP`
  # every start and risking a media candidate that routes out and back. Set `true`
  # only when real external browser clients connect directly to this server.
  # (livekit-sip keeps its OWN use_external_ip: true — that side faces the carrier.)
  use_external_ip: false

# livekit-sip coordination. Without this, `lk sip ...` returns
# "sip not connected (redis required)".
redis:
  address: redis:6379

keys:
  devkey: devsecret-change-me-before-real-use

log_level: info

# Prometheus metrics. Note the NESTED key — the flat `prometheus_port:` form is
# deprecated and the server warns about it at boot.
prometheus:
  port: 6789
